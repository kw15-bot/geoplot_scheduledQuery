/notam_out/**/*.json
/notam_out/**/*.geojson
/notam_out/**/*.md
/msa_out/**/*.json
/msa_out/**/*.geojson
/msa_out/**/*.md
/layers/**/*.json
/layers/**/*.geojson
/layers/**/*.md
/news_out/**/*.json
/news_out/**/*.md
/HANDOFF.md
/HANDOFF_NOTAM.md

